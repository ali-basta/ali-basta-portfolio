# ---- Robot ----
UR_ROBOT_IP=192.0.2.10
LOCAL_SERVER_HOST=192.0.2.20
LOCAL_SERVER_PORT=8000

# ---- LLM backend: "openai" or "ollama" ----
LLM_PROVIDER=ollama

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Ollama (only needed when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BEARER=
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# ---- Camera ----
CAM_INDEX=0
CAM_FPS=60

# ---- Quality gate (Raspberry Pi) ----
GATE_PORT=5000
SHOW_PREVIEW=0
